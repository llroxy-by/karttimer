{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Arduino: 编译",
      "type": "shell",
      "command": "/Applications/Arduino IDE.app/Contents/Resources/app/lib/backend/resources/arduino-cli",
      "args": [
        "compile",
        "--fqbn",
        "esp32:esp32:esp32",
        "sketch_aug14a"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Arduino: 上传",
      "type": "shell",
      "command": "/Applications/Arduino IDE.app/Contents/Resources/app/lib/backend/resources/arduino-cli",
      "args": [
        "upload",
        "-p",
        "/dev/cu.usbserial-0001",
        "--fqbn",
        "esp32:esp32:esp32",
        "sketch_aug14a"
      ],
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Arduino: 编译并上传",
      "dependsOn": [
        "Arduino: 编译",
        "Arduino: 上传"
      ],
      "problemMatcher": [],
      "group": {
        "kind": "build"
      }
    }
  ]
}
